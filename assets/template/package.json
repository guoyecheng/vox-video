{
  "name": "vox-video",
  "version": "1.0.0",
  "private": true,
  "description": "VOX 风格解说视频：旁白驱动的时间轴",
  "scripts": {
    "tts": "python \"<scaffold 会改写成 vox_tts.py 的绝对路径>\" --project .",
    "preflight": "python \"<scaffold 会改写成 preflight.py 的绝对路径>\" --project .",
    "stills": "python \"<scaffold 会改写成 stills.py 的绝对路径>\" --project . --sheet",
    "studio": "remotion studio",
    "render": "remotion render VoxVideo out/video.mp4",
    "cover": "remotion render VoxVideo out/cover.png --frame=45"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "@remotion/cli": "4.0.535",
    "@remotion/google-fonts": "4.0.535",
    "@remotion/media-utils": "4.0.535",
    "@remotion/three": "4.0.535",
    "@remotion/transitions": "4.0.535",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.535",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "@types/react-dom": "19.0.0",
    "@types/three": "^0.180.0",
    "typescript": "5.6.3"
  }
}