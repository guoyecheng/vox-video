{
  "100": {
    "class_type": "UnetLoaderGGUF",
    "inputs": { "unet_name": "{{unet}}" }
  },
  "101": {
    "class_type": "ModelSamplingFlux",
    "inputs": {
      "model": ["100", 0],
      "max_shift": 1.15,
      "base_shift": 0.5,
      "width": "{{width}}",
      "height": "{{height}}"
    }
  },
  "102": {
    "class_type": "DualCLIPLoader",
    "inputs": {
      "clip_name1": "{{clip}}",
      "clip_name2": "{{clip2}}",
      "type": "flux",
      "device": "cpu"
    }
  },
  "27": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{prompt}}", "clip": ["102", 0] }
  },
  "31": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "{{negative}}", "clip": ["102", 0] }
  },
  "13": {
    "class_type": "EmptySD3LatentImage",
    "inputs": { "width": "{{width}}", "height": "{{height}}", "batch_size": 1 }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["101", 0],
      "seed": "{{seed}}",
      "steps": "{{steps}}",
      "cfg": "{{cfg}}",
      "sampler_name": "euler",
      "scheduler": "simple",
      "positive": ["27", 0],
      "negative": ["31", 0],
      "latent_image": ["13", 0],
      "denoise": 1.0
    }
  },
  "29": {
    "class_type": "VAELoader",
    "inputs": { "vae_name": "{{vae}}" }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["29", 0] }
  },
  "60": {
    "class_type": "SaveImage",
    "inputs": { "images": ["8", 0], "filename_prefix": "vox/{{id}}" }
  }
}
